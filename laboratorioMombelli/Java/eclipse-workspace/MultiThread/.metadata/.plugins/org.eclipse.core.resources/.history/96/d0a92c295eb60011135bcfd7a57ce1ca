package lez02;

public class RaceThread extends Thread {
	
	String nome;
	int time;
	
	public RaceThread(String nome, int time) {
		super();
		this.nome = nome;
		this.setName(nome);
		this.time = time;
	}


	@Override
	public void run() {
		for (int i = 0; i< 5; i++) {
			try {
				System.out.println("Sono il thread: " + this.nome);
				System.out.println("Ho percorso " + (i + 1) + " metri");
				Thread.sleep(1000);
			}catch (InterruptedException e) {
				e.printStackTrace();
			}
		}
	}

}
